# PostgreSQL (EasyPanel injeta automaticamente se usar o serviço managed,
# ou setter manualmente se for container separado)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=soap_psiquiatria
DB_USER=postgres
DB_PASS=sua_senha_forte_aqui

